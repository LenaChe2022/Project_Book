<%- include('partials/header.ejs'); -%>

<div class="box" id="heading">
    <h1>
        <%= listTitle %>
    </h1>
</div>
<div class="box">
    <form class="sorting" action="/" metod="get">
        <label for="sort">Sort: </label>
        <select name="sort" id="sort">
            <option value="ASC">from old to new</option>
            <option value="DESC">from new to old</option>
        </select>
        <input type="submit" value="Submit">
    </form>
</div>
<div class="box">
  <% for(let item of listItems){%> 
    <a href="book/<%=item.id%>">
    <div class="item innerbox">
        <div class="bookitem" id="open<%=item.id%>" onclick="handler('<%=item.id%>')">
            <div class="bookname">
                <h2 id="title<%=item.id%>">
                    <%= item.bookName %>
                </h2>
            </div>
            <div class="bookinfo">
                <div class="cover">
                    <img class="bookcover" src="<%= item.cover%>" width="150">
                </div>

                <div class="maininfo">
                    <h2 id="author<%=item.id%>">
                        <%= item.author %>
                    </h2>
                    <h3>Read on <%= item.dateRead %></h3>
                    <h3>My Summary:</h3>
                    <p class="quotes">"<%= item.summary%>"</p>
                    <h3>rate <%= item.rating %>/10</h3>
                </div>
    
            </div>
            <div class="booknotes">
                <% for(let note of item.notes) {%>
                    <p>"<%= note.note %>"</p>
                <% } %>
            </div>
        </div>
        <!-- <img class="bookcover" src="<%= item.cover%>" width="200"> -->

        <!-- <form action="/delete" method="post">
            <input type="checkbox" onchange="this.form.submit()" name="deleteItemId" value="<%= item.id %>">
        </form> -->

        <!-- <p id="title<%=item.id%>">
            <%= item.bookName %>
        </p> -->

        <!-- <form class="edit" action="/edit" method="post">
            <input type="hidden" name="updatedItemId" value="<%= item.id %>"/>
            <input id="input<%=item.id%>" type="text" name="updatedItemTitle" value="<%= item.title%>" autocomplete="off"
              autofocus="true" hidden="true"/>
            <button id="done<%=item.id%>" class="edit" type="submit" hidden>
                <img class="icon" src="/assets/icons/check-solid.svg" alt="tick image">
            </button>
        </form>
        <button id="edit<%=item.id%>" class="edit" onclick="handler('<%=item.id%>')">
            <img class="icon" src="/assets/icons/pencil-solid.svg" alt="pencil image">
        </button> -->
    </div>
    </a>
  <% } %>  
</div>

<a href="/add">
    <div class="box" id="adding">
        <h2>
           + Add Book
        </h2>
    </div>
</a>

<script>
    function handler(id) {
        document.getElementById("title" + id).setAttribute("hidden", true)
        document.getElementById("edit" + id).setAttribute("hidden", true)
        document.getElementById("done" + id).removeAttribute("hidden")
        document.getElementById("input" + id).removeAttribute("hidden")
    }

    // function handler(id) {
    //     document.getElementById("open" + id).addEventListener("click", handleClick(id));
    // }

    function handleClick(id){
        // alert("I got clicked with id" + id);
        redirect(`/book${id}`);
    }
</script>

<%- include('partials/footer.ejs'); -%>